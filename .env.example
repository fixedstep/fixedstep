# Copy to .env at the repo root. Used by apps/api, packages/db and packages/content-cli.
DATABASE_URL=postgres://fixedstep:fixedstep@localhost:5432/fixedstep

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Optional OAuth (leave blank to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Grader: "local" runs QuickJS in-process; "lambda" invokes GRADER_FUNCTION_NAME
GRADER_MODE=local
GRADER_FUNCTION_NAME=

# Polar (merchant of record). Use the sandbox environment locally.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRO_PRODUCT_ID=
