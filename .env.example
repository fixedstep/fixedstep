# Copy to .env at the repo root. Used by apps/api, packages/db and packages/content-cli.
DATABASE_URL=postgres://fixedstep:fixedstep@localhost:5432/fixedstep

# Content the content:* scripts load, relative to this repo. Point it at a checkout of the private
# content repo; docker compose mounts it into the containers. Default: content-sample
CONTENT_DIR=

# Better Auth — required; generate with: openssl rand -base64 32 (the API won't start without it)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Optional OAuth (leave blank to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Grader: "local" runs QuickJS in-process; "http" calls the grader service at GRADER_URL
GRADER_MODE=local
GRADER_URL=
GRADER_TOKEN=

# Enables POST /internal/content (content publishing from CI); leave blank locally
CONTENT_SYNC_TOKEN=

# Polar (merchant of record). Use the sandbox environment locally.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# One Polar product per billing interval; leave one blank to disable that interval's checkout.
POLAR_PRO_MONTHLY_PRODUCT_ID=
POLAR_PRO_YEARLY_PRODUCT_ID=

# Email: "log" prints verification/reset links to the API console. "smtp" sends through
# SMTP_URL (e.g. smtps://user:pass@smtp.example.com:465) from EMAIL_FROM.
EMAIL_PROVIDER=log
SMTP_URL=
EMAIL_FROM=
